# Copy to .env and fill in. See ../README.md for what each value does and how to get it.

DATABASE_URL="postgresql://esim@localhost:15433/esim?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3100
APP_URL="http://localhost:8090"
PUBLIC_API_URL="http://localhost:3100"

# Provider: mock (default, offline, no eSIM Access account needed) | esimaccess (live, spends real balance)
PROVIDER=mock
ESIMACCESS_ACCESS_CODE=
MARKUP_PERCENT=40

# Payments: mock auto-succeeds after a short delay (no keys needed) | live uses real Stripe + M-Pesa Daraja
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=change-me-random-string
KES_PER_USD=129

# Auth / admin / notifications
OTP_DEV_ECHO=true
ADMIN_EMAILS=admin@example.com
LOW_BALANCE_CENTS=5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="eSIM Store <no-reply@localhost>"
