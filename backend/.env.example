# Copy to .env and fill in. See ../README.md for what each value does and how to get it.

DATABASE_URL="postgresql://esim@localhost:15433/esim?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3100
APP_URL="http://localhost:8090"
PUBLIC_API_URL="http://localhost:3100"

# Provider: mock (default, offline, no eSIM Access account needed) | esimaccess (live, spends real balance)
PROVIDER=mock
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=
MARKUP_PERCENT=40

# Payments: mock auto-succeeds after a short delay (no keys needed) | live uses real Stripe + M-Pesa Daraja
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=change-me-random-string
KES_PER_USD=129

# Auth / admin / notifications
OTP_DEV_ECHO=true
ADMIN_EMAILS=admin@example.com
LOW_BALANCE_CENTS=5000

# Email: Resend's HTTP API is preferred (works on any host, incl. Railway Hobby, which blocks
# outbound SMTP ports). Falls back to SMTP below if RESEND_API_KEY is unset, then to console logging.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="eSIM Store <no-reply@localhost>"

# SMS (phone OTP) via Africa's Talking. Leave blank to just log codes to the console (dev).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
BRAND_NAME="eSIM Store"

# Comma-separated list of allowed web origins, e.g. https://example.com,https://preview.example.com
# Leave blank in local dev to allow any origin.
WEB_ORIGIN=
